---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  /** Used to build descriptive alt text, e.g. the event title. */
  label?: string;
  /** Optional unique id (useful when several galleries share one page). */
  id?: string;
}

const { images, label = 'Event', id } = Astro.props;

// Pre-generate an optimized thumbnail and a larger lightbox image for each
// photo. PhotoSwipe needs the full image's pixel dimensions up front.
const items = await Promise.all(
  images.map(async (img, i) => {
    const thumb = await getImage({
      src: img,
      width: 700,
      height: 525,
      fit: 'cover',
      format: 'webp',
    });
    const fullWidth = Math.min(img.width, 2000);
    const fullHeight = Math.round((fullWidth * img.height) / img.width);
    const full = await getImage({
      src: img,
      width: fullWidth,
      format: 'webp',
    });
    return {
      thumb: thumb.src,
      full: full.src,
      width: fullWidth,
      height: fullHeight,
      alt: `${label} — photo ${i + 1}`,
    };
  })
);
---

{
  items.length > 0 && (
    <div class="gallery pswp-gallery" id={id}>
      {items.map((it) => (
        <a
          class="gallery__item"
          href={it.full}
          data-pswp-width={it.width}
          data-pswp-height={it.height}
          target="_blank"
          rel="noreferrer"
        >
          <img src={it.thumb} alt={it.alt} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
  }
  .gallery__item {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-accent-soft);
    cursor: zoom-in;
  }
  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }
  .gallery__item:hover img {
    transform: scale(1.04);
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // A page can have several galleries (one per event). PhotoSwipe treats each
  // element matching this selector as its own group, so a single lightbox
  // instance handles them all.
  const lightbox = new PhotoSwipeLightbox({
    gallery: '.pswp-gallery',
    children: 'a',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();
</script>
